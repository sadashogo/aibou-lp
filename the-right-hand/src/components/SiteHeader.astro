---
import { site } from '../data/site';
---

<header
  class="fixed top-0 left-0 right-0 z-50 flex items-center justify-between border-b px-5 py-4 sm:px-9 sm:py-6"
  style="background: rgba(6,6,8,0.9); backdrop-filter: blur(16px); border-color: var(--color-hairline-head);"
>
  <div class="min-w-0">
    <span
      class="mono text-[13px] font-semibold"
      style="color: var(--color-ink-bright); letter-spacing: 0.28em;"
      >{site.brandTitle}</span
    >
    <span
      class="ml-3 hidden text-[11px] sm:inline"
      style="color: var(--color-ink-faint);">{site.brandSub}</span
    >
  </div>
  <a
    href={site.headerCtaHref}
    class="mono shrink-0 border px-4 py-[7px] text-[11px] transition-colors duration-200"
    style="color: var(--color-ink-bright); border-color: var(--color-hairline-btn);"
    >{site.headerCtaLabel}</a
  >
</header>

<style>
  a:hover {
    background: #fff;
    color: #000;
  }
</style>
