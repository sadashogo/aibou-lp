---
// よくある質問の開閉リスト。同じ質問を Base の faqs に渡すと、構造化データ（FAQPage）にもなる
import type { Faq } from '../data/site';

interface Props { faqs: Faq[]; open?: boolean }
const { faqs, open = false } = Astro.props;
---
<div class="faq">
  {faqs.map((f) => (
    <details open={open}>
      <summary>{f.q}</summary>
      <p>{f.a}</p>
    </details>
  ))}
</div>

<style>
  .faq details { border-bottom: 1px dashed var(--color-rule); padding-block: var(--space-sm); }
  .faq details:first-of-type { border-top: 1px dashed var(--color-rule); }
  .faq summary { font-weight: 700; cursor: pointer; list-style: none; padding-right: 2em; position: relative; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; position: absolute; right: 0.25em; top: 0; font-size: var(--text-xl); line-height: 1.3; }
  .faq details[open] summary::after { content: '−'; }
  .faq details p { margin-top: var(--space-xs); color: var(--color-ink-soft); font-size: var(--text-sm); }
</style>
