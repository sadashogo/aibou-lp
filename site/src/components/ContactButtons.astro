---
import { site } from '../data/site';

// position: GA4 のイベントに付ける置き場所（どのボタンから予約されたかを見るため）
interface Props { position: string }
const { position } = Astro.props;
---
<div class="contact">
  <a class="btn" href={site.bookingUrl} target="_blank" rel="noopener" data-track="booking_click" data-position={position}>無料相談を予約する</a>
  <a class="btn btn--line" href={site.lineUrl} target="_blank" rel="noopener" data-track="line_click" data-position={position}>LINEで問い合わせる</a>
</div>
<p class="contact-note muted">予約は空いている日時を選ぶだけ（約1分）。確定するとGoogle MeetのURLが自動で届きます。</p>

<style>
  .contact { display: flex; flex-wrap: wrap; gap: var(--space-sm); }
  .contact-note { margin-top: var(--space-sm); }
  @media (max-width: 480px) { .contact .btn { width: 100%; } }
</style>
