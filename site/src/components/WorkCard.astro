---
import type { Work } from '../data/site';

interface Props { work: Work; headingLevel?: 'h2' | 'h3' }
const { work, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---
<article class="work">
  <a class="work-link" href={work.url} target="_blank" rel="noopener">
    {work.image ? (
      <img class="work-thumb" src={work.image} alt={`${work.name} のサムネイル画像`} width="960" height="504" loading="lazy" />
    ) : (
      <div class="work-thumb work-thumb--type" aria-hidden="true">
        <span>{work.name}</span>
      </div>
    )}
    <div class="work-body">
      <p class="work-kind">{work.kind}</p>
      <H class="work-name">{work.name}</H>
      <p class="work-desc">{work.description}</p>
      <ul class="work-points">
        {work.points.map((p) => <li>{p}</li>)}
      </ul>
      <span class="work-open">サイトを開く <span aria-hidden="true">↗</span><span class="sr">（別のタブで開きます）</span></span>
    </div>
  </a>
</article>

<style>
  .work-link {
    display: grid; height: 100%; text-decoration: none;
    background: var(--color-card); border: 2px solid var(--color-ink); border-radius: var(--radius-md);
    overflow: hidden; box-shadow: 4px 4px 0 var(--color-rule);
    transition: transform var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  }
  .work-link:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--color-rule); }
  .work-thumb { width: 100%; aspect-ratio: 1200 / 630; object-fit: cover; border-bottom: 2px solid var(--color-ink); }
  .work-thumb--type {
    display: grid; place-items: center; background: var(--color-paper-2);
    font-family: var(--font-hand); font-weight: 600; font-size: var(--text-display);
  }
  .work-body { padding: var(--space-lg); display: grid; gap: var(--space-xs); align-content: start; }
  .work-kind { font-size: var(--text-sm); color: var(--color-ink-soft); }
  .work-name { font-size: var(--text-2xl); }
  .work-desc { font-size: var(--text-sm); }
  .work-points { display: flex; flex-wrap: wrap; gap: var(--space-2xs) var(--space-xs); margin: var(--space-2xs) 0 0; padding: 0; list-style: none; }
  .work-points li {
    font-size: 0.8125rem; line-height: 1.6; padding: 2px 10px;
    border: 1.5px solid var(--color-ink); border-radius: 999px; background: var(--color-paper);
  }
  .work-open { margin-top: var(--space-sm); font-family: var(--font-hand); font-weight: 600; white-space: nowrap; }
  .work-link:hover .work-open { background: linear-gradient(transparent 62%, var(--color-marker) 62%); justify-self: start; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) { .work-link, .work-link:hover { transition: none; transform: none; } }
</style>
