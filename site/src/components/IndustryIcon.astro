---
import type { IndustryIcon } from '../data/industries';

interface Props { kind: IndustryIcon; size?: number }
const { kind, size = 48 } = Astro.props;
---
<svg aria-hidden="true" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
  {kind === 'truck' && (
    <>
      <path d="M3 6h11v10H3z" /><path d="M14 9h4l3 3v4h-7" /><circle cx="7" cy="17" r="2" /><circle cx="17" cy="17" r="2" />
    </>
  )}
  {kind === 'scissors' && (
    <>
      <circle cx="6" cy="6" r="3" /><circle cx="6" cy="18" r="3" /><path d="M8.6 7.5L20 18" /><path d="M8.6 16.5L20 6" />
    </>
  )}
</svg>
