---
import Base from '../layouts/Base.astro';
import OwnerFigure from '../components/OwnerFigure.astro';
import FaqList from '../components/FaqList.astro';
import { site, faqs } from '../data/site';

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.owner,
  jobTitle: 'AIBOU 代表',
  description: site.ownerBio,
  worksFor: { '@id': `${site.url}/#org` },
  sameAs: [site.noteUrl],
};
---
<Base title="AIBOUについて" description="AIBOU（アイボウ）は、小さな会社と個人事業主の隣で一緒に手を動かす、AI・デジタル活用の支援です。代表・定方翔吾の紹介。" faqs={faqs} jsonLd={[person]}>
  <section class="narrow page-head">
    <h1>AIBOUについて</h1>
  </section>

  <section class="narrow owner">
    <OwnerFigure size={144} />
    <div>
      <p class="muted">代表</p>
      <p class="owner-name">{site.owner}</p>
      <p class="owner-bio">{site.ownerBio}</p>
    </div>
  </section>

  <section class="narrow letter">
    <p>
      大手コンサルのような大がかりなDXではなく、<span class="mk">小さな事業の隣で一緒に手を動かすスタイル</span>のAI・デジタル活用の支援です。
    </p>
    <p>
      運送会社でのDX担当として、配車作業の自動化や補助金の申請、各種認定の取得に取り組んできました。現場の仕事の流れに入り込んで、実際に使われるところまで作るのが得意です。
    </p>
    <p>
      「AIBOU（アイボウ）」という名前には、いつでも隣で気軽に頼れる“相棒”でありたい、という思いを込めています。
    </p>
    <p class="sign">— {site.name} {site.owner}</p>
    <p class="about-links">
      <a href="/made/">これまでにつくったもの</a>
      <a href={site.noteUrl} target="_blank" rel="noopener" data-track="note_click" data-position="about">noteで書いていること <span aria-hidden="true">↗</span></a>
    </p>
  </section>

  <section class="section narrow">
    <h2 class="faq-title">よくある質問</h2>
    <FaqList faqs={faqs} />
  </section>
</Base>

<style>
  .page-head { padding-block: var(--space-2xl) var(--space-lg); }
  .page-head h1 { font-size: var(--text-display); }
  .letter {
    border-left: 4px solid var(--color-marker); padding: var(--space-2xs) 0 var(--space-2xs) var(--space-lg);
    margin-bottom: var(--space-2xl);
  }
  .about-links { display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-xl); margin-top: var(--space-lg); font-weight: 700; }
  .letter p + p { margin-top: var(--space-md); }
  .sign { text-align: right; font-weight: 700; }

  .faq-title { font-size: var(--text-2xl); margin-bottom: var(--space-lg); }
  .owner { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-lg); margin-bottom: var(--space-2xl); }
  .owner > div { flex: 999 1 18rem; min-width: 0; }
  .owner-name { font-family: var(--font-hand); font-weight: 600; font-size: var(--text-xl); }
  .owner-bio { color: var(--color-ink-soft); }
</style>
