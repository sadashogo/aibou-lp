---
import Base from '../layouts/Base.astro';
import ContactButtons from '../components/ContactButtons.astro';
import MadeCard from '../components/MadeCard.astro';
import ServiceCards from '../components/ServiceCards.astro';
import IndustryIcon from '../components/IndustryIcon.astro';
import OwnerFigure from '../components/OwnerFigure.astro';
import FaqList from '../components/FaqList.astro';
import { site, voices, consultSteps, faqs, results } from '../data/site';
import { madeTop } from '../data/made';
import { industries } from '../data/industries';
import { getNoteArticles } from '../data/note';
import { getColumns, formatDate } from '../data/columns';

const notes = await getNoteArticles(site.noteRss);
const columns = getColumns(3);
const salonVoice = voices.find((v) => v.case === 'CASE 02')!;
---
<Base
  description="群馬の小さな会社・お店のための、AI導入と業務改善。AIの初期設定と業務の自動化から始めて、月額のAI顧問で改善を続けます。運送業・美容業の事例あり。無料30分相談受付中。"
  faqs={faqs}
>
  <div class="hero-band">
    <section class="hero wrap">
      <div class="hero-text">
        <p class="hero-for">群馬の小さな会社・お店のための<span>AI導入と業務改善</span></p>
        <h1 class="hero-title">経営者の隣に、<br /><span class="mk">AIの相棒</span>を。</h1>
        <p class="hero-sub">
          むずかしい用語は使いません。運送業やサロンの現場で仕組みを作ってきた人が、AIの導入から毎月の改善まで一緒に進めます。
        </p>
        <ul class="hero-badges" aria-label="無料相談について">
          <li>相談は無料</li><li>30分</li><li>オンライン</li><li>売り込みなし</li>
        </ul>
        <ContactButtons position="hero" />
      </div>
      <figure class="hero-steps" aria-labelledby="hero-steps-cap">
        <figcaption id="hero-steps-cap">AIBOUの進め方</figcaption>
        <ol>
          <li><b>無料30分相談</b><span>困っている作業を一緒に洗い出す</span></li>
          <li><b>AI導入</b><span>初期設定＋業務をひとつ自動化</span></li>
          <li class="is-mark"><b>AI顧問</b><span>毎月少しずつ、改善を続ける</span></li>
        </ol>
      </figure>
    </section>
  </div>

  <section class="proof" aria-label="これまでの実績">
    <div class="wrap">
      <ul class="proof-list">
        <li class="proof-item">
          <p class="proof-num"><span class="mk">サロン2社</span></p>
          <p class="proof-sub">を、毎月続けて支援しています</p>
        </li>
        <li class="proof-item">
          <p class="proof-quote">「{salonVoice.headline}」</p>
          <p class="proof-sub">{salonVoice.context}・{salonVoice.person}　<a href="/works/#voices">声をすべて読む</a></p>
        </li>
        <li class="proof-item">
          <p class="proof-num">{results.metric.value.split(' → ').map((v, i) => <>{i > 0 && ' → '}<span class="nb mk">{v}</span></>)}</p>
          <p class="proof-sub">運送会社の配車作業（勤務先での取り組み）　<a href={results.metric.note} target="_blank" rel="noopener" data-track="note_click" data-position="top_proof">noteで読む <span aria-hidden="true">↗</span></a></p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section wrap" id="service">
    <h2 class="sec-title">サービスは<span class="mk">3つだけ</span></h2>
    <p class="lead sec-lead">まずAI導入で始めて、AI顧問で続ける。大きな開発が必要になったら、オーダーメイドで作ります。</p>
    <ServiceCards />
    <p class="more"><a href="/pricing/">料金とプランの違いを見る</a></p>
  </section>

  <section class="band" id="industry" aria-labelledby="industry-title">
    <div class="wrap band-inner">
      <h2 id="industry-title" class="sec-title"><span class="mk">業種別</span>にできること</h2>
      <p class="lead sec-lead">同じAIでも、業種によって効くところが違います。</p>
      <ul class="ind-cards">
        {industries.map((ind) => (
          <li>
            <a href={`/industry/${ind.slug}/`}>
              <IndustryIcon kind={ind.icon} />
              <span class="ind-text"><b>{ind.name}</b><span>{ind.short}</span></span>
              <span class="ind-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="muted ind-more">ほかの業種も、まずは無料相談でご相談ください。</p>
    </div>
  </section>

  <section class="section wrap">
    <h2 class="sec-title"><span class="mk">つくったもの</span></h2>
    <p class="lead sec-lead">これまでに作った仕組みの一部です。運送業の事例は、定方が社内のDX担当として作ったものです。</p>
    <div class="grid3">
      {madeTop.map((m) => <MadeCard item={m} compact />)}
    </div>
    <p class="more"><a href="/made/">つくったものをすべて見る</a></p>
  </section>

  <section class="band" aria-labelledby="column-title">
    <div class="wrap band-inner">
      <div class="col-head">
        <div>
          <h2 id="column-title" class="sec-title"><span class="mk">発信</span>しています</h2>
          <p class="lead">現場で試したAIの使い方を、むずかしい言葉なしで書いています。</p>
        </div>
        <a class="col-all" href="/column/">コラム一覧 <span aria-hidden="true">→</span></a>
      </div>
      <ul class="col-cards">
        {columns.map((c) => (
          <li>
            <a href={c.url}>
              <span class="col-meta">コラム{c.tag && `・${c.tag}`}　{formatDate(c.date)}</span>
              <span class="col-title">{c.title}</span>
            </a>
          </li>
        ))}
        {notes.slice(0, Math.max(0, 3 - columns.length)).map((n) => (
          <li>
            <a href={n.url} target="_blank" rel="noopener" data-track="note_click" data-position="top_notes_article">
              <span class="col-meta">note　{n.date}</span>
              <span class="col-title">{n.title} <span aria-hidden="true">↗</span></span>
            </a>
          </li>
        ))}
      </ul>
      <p class="col-links"><a href={site.noteUrl} target="_blank" rel="noopener" data-track="note_click" data-position="top_notes">noteでも書いています <span aria-hidden="true">↗</span></a></p>
    </div>
  </section>

  <section class="section wrap owner" id="owner" aria-labelledby="owner-title">
    <OwnerFigure />
    <div>
      <p class="muted">代表について</p>
      <h2 id="owner-title" class="owner-name">{site.owner}</h2>
      <p class="lead">{site.ownerBio}</p>
      <p class="more"><a href="/about/">AIBOUについて</a></p>
    </div>
  </section>

  <section class="section wrap help">
    <div>
      <h2 class="sec-title">相談の流れ</h2>
      <ol class="flow">
        {consultSteps.map((s) => (
          <li><b>{s.title}</b><span>{s.body}</span></li>
        ))}
      </ol>
      <p class="muted">受付は{site.consultHours}・先着順です。</p>
    </div>
    <div>
      <h2 class="sec-title">よくある質問</h2>
      <FaqList faqs={faqs} />
    </div>
  </section>
</Base>

<style>
  .hero-band {
    background-image:
      linear-gradient(var(--color-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-grid) 1px, transparent 1px);
    background-size: 26px 26px;
  }
  .hero {
    display: grid; gap: var(--space-2xl); align-items: center;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    padding-block: var(--space-2xl) var(--space-3xl);
  }
  .hero-for { display: grid; gap: 2px; font-size: var(--text-sm); color: var(--color-ink-soft); margin-bottom: var(--space-sm); }
  .hero-for span { font-weight: 700; color: var(--color-ink); }
  .hero-title { font-size: var(--text-display); line-height: 1.45; margin-bottom: var(--space-lg); }
  .nb { display: inline-block; }
  .hero-sub { color: var(--color-ink-soft); max-width: 34rem; margin-bottom: var(--space-md); }
  .hero-badges { display: flex; flex-wrap: wrap; gap: var(--space-xs); margin: 0 0 var(--space-lg); padding: 0; list-style: none; }
  .hero-badges li {
    font-size: var(--text-sm); font-weight: 700; padding: 2px 12px; white-space: nowrap;
    border: 1.5px solid var(--color-ink); border-radius: 999px; background: var(--color-card);
  }

  .hero-steps {
    margin: 0; padding: var(--space-lg); background: var(--color-card);
    border: 2px solid var(--color-ink); border-radius: var(--radius-md); box-shadow: 6px 6px 0 var(--color-ink);
  }
  .hero-steps figcaption { font-size: 0.75rem; font-weight: 700; color: var(--color-ink-faint); margin-bottom: var(--space-sm); }
  .hero-steps ol { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-md); counter-reset: hs; }
  .hero-steps li { counter-increment: hs; display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); column-gap: var(--space-sm); align-items: center; }
  .hero-steps li::before {
    content: counter(hs); grid-row: span 2; display: grid; place-items: center; width: 2.5rem; height: 2.5rem;
    font-family: var(--font-hand); font-weight: 600; border: 2px solid var(--color-ink); border-radius: 50% 45% 55% 48%; background: var(--color-card);
  }
  .hero-steps li.is-mark::before { background: var(--color-marker-strong); }
  .hero-steps b { font-family: var(--font-hand); font-weight: 600; font-size: var(--text-lg); line-height: 1.4; }
  .hero-steps span { font-size: var(--text-sm); color: var(--color-ink-soft); line-height: 1.6; }
  @media (max-width: 860px) {
    .hero { grid-template-columns: minmax(0, 1fr); padding-block: var(--space-xl) var(--space-2xl); gap: var(--space-xl); }
  }

  .proof { background: var(--color-card); border-block: 2px solid var(--color-ink); }
  .proof-list { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr) minmax(0, 1fr); margin: 0; padding-block: var(--space-xl); list-style: none; }
  .proof-item { display: grid; align-content: center; gap: var(--space-2xs); padding: var(--space-sm) var(--space-lg); }
  .proof-item + .proof-item { border-left: 1px dashed var(--color-rule); }
  .proof-num { font-family: var(--font-hand); font-weight: 600; font-size: var(--text-2xl); line-height: 1.3; }
  .proof-quote { font-family: var(--font-hand); font-weight: 600; font-size: var(--text-lg); line-height: 1.6; }
  .proof-sub { font-size: var(--text-sm); color: var(--color-ink-soft); }
  .proof-sub a { font-weight: 700; color: var(--color-ink); white-space: nowrap; }
  @media (max-width: 860px) {
    .proof-list { grid-template-columns: minmax(0, 1fr); padding-block: var(--space-md); }
    .proof-item { padding: var(--space-md) 0; }
    .proof-item + .proof-item { border-left: 0; border-top: 1px dashed var(--color-rule); }
  }

  .sec-title { font-size: var(--text-2xl); margin-bottom: var(--space-lg); }
  .sec-lead { max-width: var(--measure); margin: calc(-1 * var(--space-sm)) 0 var(--space-xl); }
  .more { margin-top: var(--space-lg); font-weight: 700; }

  .band { background: var(--color-paper-2); border-block: 1px dashed var(--color-rule); }
  .band-inner { padding-block: var(--space-2xl); }

  .ind-cards { display: grid; gap: var(--space-lg); grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 0; padding: 0; list-style: none; }
  @media (max-width: 760px) { .ind-cards { grid-template-columns: minmax(0, 1fr); } }
  .ind-cards a {
    display: flex; align-items: center; gap: var(--space-lg); height: 100%; padding: var(--space-lg); text-decoration: none;
    background: var(--color-card); border: 1px solid var(--color-rule); border-radius: var(--radius-md);
  }
  .ind-cards a:hover { border-color: var(--color-ink); }
  .ind-text { flex: 1; min-width: 0; display: grid; }
  .ind-text b { font-family: var(--font-hand); font-weight: 600; font-size: var(--text-xl); }
  .ind-text span { font-size: var(--text-sm); color: var(--color-ink-soft); line-height: 1.8; }
  .ind-arrow { font-size: var(--text-xl); }
  .ind-more { margin-top: var(--space-md); }

  .grid3 { display: grid; gap: var(--space-xl); grid-template-columns: repeat(3, minmax(0, 1fr)); }
  @media (max-width: 1000px) { .grid3 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .grid3 { grid-template-columns: minmax(0, 1fr); } }

  .col-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--space-md); margin-bottom: var(--space-xl); }
  .col-head .sec-title { margin-bottom: var(--space-xs); }
  .col-all { font-weight: 700; white-space: nowrap; }
  .col-cards { display: grid; gap: var(--space-lg); grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); margin: 0; padding: 0; list-style: none; }
  .col-cards a {
    display: grid; align-content: start; gap: var(--space-2xs); height: 100%; padding: var(--space-md) var(--space-lg); text-decoration: none;
    background: var(--color-card); border: 1px solid var(--color-rule); border-radius: var(--radius-md);
  }
  .col-cards a:hover { border-color: var(--color-ink); }
  .col-cards a:hover .col-title { text-decoration: underline; }
  .col-meta { font-size: 0.75rem; font-weight: 700; color: var(--color-ink-faint); font-variant-numeric: tabular-nums; }
  .col-title { font-family: var(--font-hand); font-weight: 600; font-size: var(--text-lg); line-height: 1.55; }
  .col-links { margin-top: var(--space-lg); font-weight: 700; font-size: var(--text-sm); }

  .owner { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-xl); }
  .owner > div { flex: 999 1 22rem; min-width: 0; }
  .owner-name { font-size: var(--text-2xl); margin-bottom: var(--space-sm); }
  @media (max-width: 640px) { .owner { justify-content: center; } }

  .help { display: grid; gap: var(--space-2xl); grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  @media (max-width: 860px) { .help { grid-template-columns: minmax(0, 1fr); } }
  .flow { list-style: none; margin: 0 0 var(--space-md); padding: 0; display: grid; gap: var(--space-md); counter-reset: step; }
  .flow li { counter-increment: step; display: grid; grid-template-columns: 2.25rem minmax(0, 1fr); column-gap: var(--space-sm); }
  .flow li::before {
    content: counter(step); grid-row: span 2; display: grid; place-items: center; width: 2.25rem; height: 2.25rem;
    font-family: var(--font-hand); font-weight: 600; border: 2px solid var(--color-ink); border-radius: 50% 45% 55% 48%; background: var(--color-card);
  }
  .flow b { font-weight: 700; }
  .flow span { font-size: var(--text-sm); color: var(--color-ink-soft); }
</style>
